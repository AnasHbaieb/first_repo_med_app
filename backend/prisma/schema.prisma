// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id          String   @id @default(cuid())
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  phone       String?
  parentPhone String?  @map("parent_phone")
  schoolYear  String   @map("school_year")
  schoolName  String   @map("school_name")
  filiere     String?
  startDate   DateTime @map("start_date") @default(now())
  createdAt   DateTime @map("created_at") @default(now())
  updatedAt   DateTime @map("updated_at") @updatedAt

  // Progress tracking
  currentMonth     Int @map("current_month") @default(1)
  currentSessions  Int @map("current_sessions") @default(0)
  
  // Relations
  progressMonths   ProgressMonth[]
  attendanceRecords AttendanceRecord[]

  @@map("students")
}

model ProgressMonth {
  id          String   @id @default(cuid())
  studentId   String   @map("student_id")
  monthNumber Int      @map("month_number")
  startDate   DateTime @map("start_date")
  endDate     DateTime? @map("end_date")
  isPaid      Boolean  @map("is_paid") @default(false)
  sessionsCompleted Int @map("sessions_completed") @default(0)
  createdAt   DateTime @map("created_at") @default(now())
  updatedAt   DateTime @map("updated_at") @updatedAt

  // Relations
  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, monthNumber])
  @@map("progress_months")
}

model AttendanceRecord {
  id        String   @id @default(cuid())
  studentId String   @map("student_id")
  date      DateTime
  isPresent Boolean  @map("is_present") @default(true)
  createdAt DateTime @map("created_at") @default(now())

  // Relations
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@map("attendance_records")
}

model ClassSchedule {
  id        String   @id @default(cuid())
  name      String
  dayOfWeek Int      @map("day_of_week") // 0 = Sunday, 1 = Monday, etc.
  startTime String   @map("start_time") // Format: "HH:MM"
  endTime   String   @map("end_time")   // Format: "HH:MM"
  isActive  Boolean  @map("is_active") @default(true)
  createdAt DateTime @map("created_at") @default(now())
  updatedAt DateTime @map("updated_at") @updatedAt

  @@map("class_schedules")
}
